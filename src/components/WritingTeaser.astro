---
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' }).format(date);
---

<section class="content-section" aria-labelledby="writing-label">
  <p id="writing-label" class="section-label">Writing</p>
  {
    posts.length === 0 ? (
      <div class="section-body">
        <p>Essays on AI quality, governance, and the economics of AI systems are in the works.</p>
        <p><a href="/writing/">Watch this space</a></p>
      </div>
    ) : (
      <>
        <ol class="writing-list">
          {posts.map((post) => (
            <li>
              <h2><a href={`/writing/${post.id}/`}>{post.data.title}</a></h2>
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              <p>{post.data.description}</p>
            </li>
          ))}
        </ol>
        <p><a href="/writing/">All essays</a></p>
      </>
    )
  }
</section>
