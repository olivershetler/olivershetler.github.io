---
import { site } from '../data/site';

interface Props {
  pageTitle?: string;
  description?: string;
  article?: boolean;
  home?: boolean;
  noindex?: boolean;
}

const {
  pageTitle,
  description = site.description,
  article = false,
  home = false,
  noindex = false,
} = Astro.props;
const title = pageTitle ? `${pageTitle} · ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Oliver Shetler',
  url: 'https://olivershetler.github.io/',
  jobTitle: 'Founder',
  alumniOf: [
    { '@type': 'CollegeOrUniversity', name: 'Hunter College' },
    { '@type': 'CollegeOrUniversity', name: 'Johns Hopkins University' },
  ],
  knowsAbout: [
    'AI governance',
    'AI quality assurance',
    'AI risk',
    'financial analysis of AI systems',
    'statistics',
    'machine learning',
  ],
  sameAs: site.socials.map(({ href }) => href),
};
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
<link rel="canonical" href={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={site.name} />
<meta name="twitter:card" content="summary" />
<link rel="sitemap" href="/sitemap-index.xml" />
{home && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
