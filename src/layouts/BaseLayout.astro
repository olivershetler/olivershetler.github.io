---
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/source-serif-4/opsz-italic.css';
import '../styles/tokens.css';
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title?: string;
  description?: string;
  article?: boolean;
  home?: boolean;
  noindex?: boolean;
}

const { title, description, article = false, home = false, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead pageTitle={title} description={description} article={article} home={home} noindex={noindex} />
  </head>
  <body>
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
